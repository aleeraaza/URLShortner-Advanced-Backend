# Paste your Neon connection string into `.env` as DATABASE_URL.
# Use the direct URL (the hostname does not contain "-pooler") for this Express app.
# Neon requires sslmode=require.
#
# If you want the app on Neon's pooler and Prisma CLI on a direct connection:
#   DATABASE_URL = pooled URL (host contains "-pooler")
#   DIRECT_URL   = direct URL (no "-pooler")
# When DIRECT_URL is unset, Prisma CLI uses DATABASE_URL.

DATABASE_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require"

NODE_ENV=development
PORT=4000
FRONTEND_URL="http://localhost:3000"

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-another-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
